# Local Terraform inputs and state
terraform.tfvars
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
crash.log
crash.*.log

# Local research and schema probes
.internal/
.schema-probe/
.portal*.py
docs/screenshots/

# Publish only the self-contained Archify HTML artifacts
docs/architecture/*
